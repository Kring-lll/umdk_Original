     DESTINATION /etc/rsyslog.d/
     PERMISSIONS OWNER_WRITE OWNER_READ)
-install(FILES "${CMAKE_SOURCE_DIR}/urma/lib/urma/config/urma"
+install(FILES "${CMAKE_CURRENT_LIST_DIR}/urma"
     DESTINATION /etc/logrotate.d/
     PERMISSIONS OWNER_WRITE OWNER_READ)
diff --git a/src/urma/lib/uvs/core/CMakeLists.txt b/src/urma/lib/uvs/core/CMakeLists.txt
index c2b24b8d..a013a6e0 100644
--- a/src/urma/lib/uvs/core/CMakeLists.txt
+++ b/src/urma/lib/uvs/core/CMakeLists.txt
@@ -22,8 +22,8 @@ target_include_directories(tpsa
         ${CMAKE_CURRENT_SOURCE_DIR}/include
     PRIVATE
         ${CMAKE_CURRENT_SOURCE_DIR}
-        ${CMAKE_SOURCE_DIR}/urma/lib/urma/core/include
-        ${CMAKE_SOURCE_DIR}/urma/common/include
+        ${CMAKE_CURRENT_LIST_DIR}/../../lib/urma/core/include
+        ${CMAKE_CURRENT_LIST_DIR}/../../common/include
 )
 
