diff --git a/src/urma/tools/urma_admin/CMakeLists.txt b/src/urma/tools/urma_admin/CMakeLists.txt
index efe6a02f..161f24a4 100644
--- a/src/urma/tools/urma_admin/CMakeLists.txt
+++ b/src/urma/tools/urma_admin/CMakeLists.txt
@@ -27,8 +27,8 @@ set_target_properties(urma_admin
 
