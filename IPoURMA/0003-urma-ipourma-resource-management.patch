 STATIC int ipourma_reset_rx_bufs(struct ipourma_dev_priv *priv, struct ubcore_cr *cr)
 {
-	/* this function will be filled in the next commit */
-	ipourma_reset_rx_buf_by_eid(priv, cr, 0);
-	return 0;
+	if (IS_ERR_OR_NULL(priv->jfr))
