package(default_visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//bazel:urma_deps.bzl", "LIBUMMU_AARCH64_RUNTIME_LINKOPTS", "LIBUMMU_ABI_VERSION", "LIBUMMU_RUNTIME_LINKOPTS")
load("//bazel:urma_shared.bzl", "urma_dynamic_linkopts", "urma_linklib_inputs", "urma_shared_library", "urma_shared_library_static_dep")

config_setting(
    name = "perf_cycle_enabled",
    values = {"define": "perf_cycle=true"},
)

config_setting(
    name = "build_udma_enabled",
    values = {"define": "build_udma=true"},
)

config_setting(
    name = "cpu_aarch64",
    values = {"cpu": "aarch64"},
)

URMA_COMMON_SRCS = glob(
    ["common/*.c"],
    exclude = ["common/ub_perf_cycle.c"],
) + select({
    ":perf_cycle_enabled": ["common/ub_perf_cycle.c"],
    "//conditions:default": [],
})

URMA_COMMON_LINKOPTS = ["-ldl", "-lrt"] + select({
    ":perf_cycle_enabled": ["-lm"],
    "//conditions:default": [],
})

cc_library(
    name = "urma_common_headers",
    hdrs = glob(["common/include/**/*.h"]),
    includes = ["common/include"],
)

urma_shared_library(
    name = "urma_common",
    srcs = URMA_COMMON_SRCS,
    hdrs = glob(["common/include/**/*.h"]),
    includes = ["common/include"],
    copts = ["-std=gnu99"],
    linkopts = URMA_COMMON_LINKOPTS,
    soname = "liburma_common.so.0",
)

cc_library(
    name = "urma_headers",
    hdrs = glob([
        "lib/urma/core/include/**/*.h",
        "lib/urma/core/*.h",
    ]),
    includes = [
        "common/include",
        "lib/urma/core",
        "lib/urma/core/include",
    ],
    deps = [":urma_common_headers"],
)

urma_shared_library(
    name = "urma",
    srcs = glob(["lib/urma/core/*.c"]),
    hdrs = glob([
        "lib/urma/core/include/**/*.h",
        "lib/urma/core/*.h",
    ]),
    includes = [
        "common/include",
        "lib/urma/core",
        "lib/urma/core/include",
    ],
    copts = ["-std=gnu99"],
    compile_deps = [":urma_common_headers"],
    dynamic_lib_names = ["urma_common"],
    linkopts = ["-ldl", "-lrt"],
    soname = "liburma.so.0",
)

urma_shared_library(
    name = "urma_ubagg",
    srcs = glob([
        "lib/urma/bond/*.c",
        "lib/urma/bond/utils/*.c",
    ]),
    hdrs = glob(["lib/urma/bond/**/*.h"]),
    includes = [
        "common/include",
        "lib/urma/bond",
        "lib/urma/bond/include",
        "lib/urma/bond/utils",
    ],
    copts = [
        "-std=gnu99",
        "-I/usr/include/libnl3",
    ],
    compile_deps = [
        ":urma_common_headers",
        ":urma_headers",
    ],
    dynamic_lib_names = ["urma", "urma_common"],
    linkopts = ["-lnl-genl-3", "-lnl-3"],
    soname = "liburma_ubagg.so.0",
)

urma_shared_library_static_dep(
    name = "tpsa",
    srcs = glob(["lib/uvs/core/*.c"]),
    hdrs = glob([
        "lib/uvs/core/include/**/*.h",
        "lib/uvs/core/*.h",
    ]),
    includes = [
        "common/include",
        "lib/urma/core/include",
        "lib/uvs/core",
        "lib/uvs/core/include",
    ],
    copts = [
        "-std=gnu99",
        "-I/usr/include/libnl3",
    ],
    static_deps = [
        ":urma_common_internal",
        ":urma_headers",
    ],
    # No -lssl/-lcrypto: avoid DT_NEEDED on libssl.so.1.1 (OpenSSL 3-only targets).
    linkopts = [
        "-lnl-genl-3",
        "-lnl-3",
    ],
    soname = "libtpsa.so.0",
)

cc_library(
    name = "uvs",
    deps = [":tpsa"],
)

alias(
    name = "uvs_tpsa",
    actual = ":tpsa",
)

cc_binary(
    name = "ummu",
    linkshared = True,
    deps = ["@libummu//:ummu_internal"],
    linkopts = [
        "-Wl,-z,relro,-z,now",
        "-Wl,-soname,libummu.so." + LIBUMMU_ABI_VERSION,
        "-Wl,--no-as-needed",
    ] + LIBUMMU_RUNTIME_LINKOPTS + select({
        ":cpu_aarch64": LIBUMMU_AARCH64_RUNTIME_LINKOPTS,
        "//conditions:default": [],
    }) + [
        "-Wl,--as-needed",
    ],
)

genrule(
    name = "ummu_linklib",
    srcs = [":ummu"],
    outs = ["linklib/libummu.so"],
    cmd = "mkdir -p $(@D) && cp $(location :ummu) $@",
)

cc_library(
    name = "urma_udma_internal",
    srcs = select({
        ":build_udma_enabled": glob(["hw/udma/*.c"]),
        "//conditions:default": [],
    }),
    hdrs = glob([
        "hw/udma/*.h",
        "hw/udma/include/**/*.h",
        "hw/udma/kernel_headers/**/*.h",
    ]),
    includes = [
        "hw/udma",
        "hw/udma/include",
        "hw/udma/kernel_headers",
        "lib/urma/core",
        "lib/urma/core/include",
    ],
    copts = ["-std=gnu99"],
    deps = select({
        ":build_udma_enabled": [
            ":urma_common_headers",
            ":urma_headers",
            "@libummu//:ummu_api",
        ],
        "//conditions:default": [
            ":urma_common_headers",
            ":urma_headers",
        ],
    }),
    linkstatic = True,
    alwayslink = True,
)

cc_binary(
    name = "urma-udma",
    linkshared = True,
    deps = [":urma_udma_internal"],
    additional_linker_inputs = select({
        ":build_udma_enabled": urma_linklib_inputs(["urma", "urma_common"]) + [
            ":ummu_linklib",
        ],
        "//conditions:default": [],
    }),
    linkopts = select({
        ":build_udma_enabled": urma_dynamic_linkopts(
            ["urma", "urma_common"],
            extra_libs = [
                "-Wl,-soname,liburma-udma.so",
                "-lummu",
            ],
        ),
        "//conditions:default": [],
    }),
)

genrule(
    name = "urma-udma_linklib",
    srcs = [":urma-udma"],
    outs = ["linklib/liburma-udma.so"],
    cmd = "mkdir -p $(@D) && cp $(location :urma-udma) $@",
)

alias(
    name = "hw_udma",
    actual = ":urma-udma",
)

cc_binary(
    name = "urma_admin",
    srcs = glob([
        "tools/urma_admin/*.c",
        "tools/urma_admin/*.h",
    ]),
    includes = [
        "common/include",
        "lib/urma/core/include",
        "tools/urma_admin",
    ],
    copts = [
        "-std=gnu99",
        "-I/usr/include/libnl3",
    ],
    additional_linker_inputs = urma_linklib_inputs(["urma", "urma_common"]),
    linkopts = urma_dynamic_linkopts(
        ["urma", "urma_common"],
        extra_libs = [
            "-lnl-genl-3",
            "-lnl-3",
        ],
    ),
    deps = [
        ":urma_common_headers",
        ":urma_headers",
    ],
)

cc_binary(
    name = "urma_perftest",
    srcs = glob([
        "tools/urma_perftest/*.c",
        "tools/urma_perftest/*.h",
        "lib/urma/bond/include/*.h",
    ]),
    includes = [
        "common/include",
        "lib/urma/bond/include",
        "lib/urma/core/include",
        "tools/urma_perftest",
    ],
    copts = ["-std=gnu99"],
    additional_linker_inputs = urma_linklib_inputs(["urma", "urma_common"]),
    linkopts = urma_dynamic_linkopts(
        ["urma", "urma_common"],
        extra_libs = [
            "-lpthread",
            "-lm",
        ],
    ),
    deps = [
        ":urma_common_headers",
        ":urma_headers",
    ],
)

cc_binary(
    name = "urma_ping",
    srcs = glob([
        "lib/uvs/core/include/*.h",
        "tools/urma_ping/*.c",
        "tools/urma_ping/*.h",
    ]),
    includes = [
        "common/include",
        "lib/urma/core/include",
        "lib/uvs/core/include",
        "tools/urma_ping",
    ],
    copts = ["-std=gnu99"],
    additional_linker_inputs = urma_linklib_inputs(["urma", "tpsa", "urma_common"]),
    linkopts = urma_dynamic_linkopts(
        ["urma", "tpsa", "urma_common"],
        extra_libs = [
            "-lm",
            "-lnl-genl-3",
            "-lnl-3",
        ],
    ),
    deps = [
        ":urma_common_headers",
        ":urma_headers",
    ],
)

cc_binary(
    name = "urma_sample",
    srcs = ["examples/urma_sample.c"],
    includes = ["lib/urma/core/include"],
    copts = ["-std=gnu99"],
    additional_linker_inputs = urma_linklib_inputs(["urma", "urma_common"]),
    linkopts = urma_dynamic_linkopts(
        ["urma", "urma_common"],
        extra_libs = ["-lpthread"],
    ),
    deps = [":urma_headers"],
)
